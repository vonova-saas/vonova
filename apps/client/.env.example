# app
NEXT_PUBLIC_APP_NAME=Vonova
NEXT_PUBLIC_APP_DOMAIN=vonova.vercel.app
NEXT_PUBLIC_AUTHOR_NAME="Vonova Company"

# metadata
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_YAHOO_VERIFICATION=

# api
NEXT_PUBLIC_API_BASE_URL=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ---------------------------------------------------------------------------
# Lesson video → S3 (presigned PUT + optional same-origin proxy)
# ---------------------------------------------------------------------------
# Presign is generated by the LMS with PutObjectCommand (never GetObject).
# The browser must send PUT with Content-Type exactly matching the presigned
# URL (the app uses video/mp4, video/quicktime, or video/webm from file name).
#
# NEXT_PUBLIC_USE_S3_UPLOAD_PROXY
#   true   → POST body to /api/lms/s3-presigned-put-proxy (no S3 CORS needed;
#            use `npm run dev` with Webpack — `npm run dev:turbo` caps bodies ~10 MiB)
#   false  → browser PUTs straight to S3 (production path; requires CORS below)
#   unset  → proxy on localhost / LAN dev IPs only; direct on other hosts
NEXT_PUBLIC_USE_S3_UPLOAD_PROXY=
#
# If direct PUT fails (e.g. CORS), retry once through the proxy without toggling
# the main flag (still needs a dev server that accepts large POST bodies):
# NEXT_PUBLIC_TRY_UPLOAD_PROXY_ON_DIRECT_FAIL=true
NEXT_PUBLIC_TRY_UPLOAD_PROXY_ON_DIRECT_FAIL=
#
# --- AWS S3 CORS (LMS video bucket, e.g. vonova-lms) ---
# Paste under S3 → bucket → Permissions → CORS. Replace production origin.
# [
#   {
#     "AllowedHeaders": ["*"],
#     "AllowedMethods": ["GET", "PUT", "POST", "DELETE", "HEAD"],
#     "AllowedOrigins": [
#       "http://localhost:3000",
#       "http://127.0.0.1:3000",
#       "https://YOUR_PRODUCTION_DOMAIN"
#     ],
#     "ExposeHeaders": ["ETag"],
#     "MaxAgeSeconds": 3000
#   }
# ]
#
# --- IAM (user/role that signs PutObject) ---
# Needs at least: s3:PutObject on arn:aws:s3:::YOUR_BUCKET/*
# plus s3:GetObject + s3:HeadObject for confirm/stream if your app uses them.

# git remote -v 
# git pull vercel main 
# git pull vercel main 
