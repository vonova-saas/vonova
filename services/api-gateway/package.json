  "main": "index.js",
  "license": "CC-BY-4.0",
  "private": true,
  "author": {
    "name": "Vonova Company",
    "email": "vonovacompany@gmail.com",
    "url": "https://vonova.tech"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vonova-saas"
  },
  "description": "Vonova is an upcoming AI-powered Learning Management System tailored for CS students and developers in the Arab world. Join our waitlist today to get early access to personalized, engaging, and structured learning journeys.",
  "homepage": "https://vonova.tech",
  "bugs": {
    "url": "https://github.com/vonova-saas"
  },
  "keywords": [
    "Vonova",
    "AI Learning Management System",
    "AI LMS",
    "Education Technology",
    "Online Courses",
    "AI Tutoring",
    "Student Platform",
    "Developer Learning",
    "Personalized Learning",
    "Middle East EdTech"
  ],
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1006.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/microservices": "^11.1.6",
