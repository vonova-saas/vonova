# =========================
# API Gateway .env.example
# =========================

# Runtime
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Stable media gateway (required — no expiring S3 GET presigns in payloads)
STABLE_MEDIA_GET_URLS=true

# Frontend / origins
FRONTEND_ORIGIN=http://localhost:3000
AI_ORIGIN=http://localhost:3001

# Admin HTTP routes (must match app service allowlist)
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=
ADMIN_EMAIL_3=
SEEDED_ADMIN_TEMP_PASSWORD=
SEED_ADMINS_ON_BOOT=false
# NATS connection (gateway -> internal microservices)
NATS_URL=nats://localhost:4222
NATS_USER=vonova_nats_user
NATS_PASSWORD=change-me-nats-password

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-CSRF-Token
CORS_EXPOSED_HEADERS=
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400
CORS_WHITELIST=
CORS_BLACKLIST=
CORS_SECURITY_HEADERS=true

# Cookie + CSRF
COOKIE_DOMAIN=localhost
ENABLE_CSRF=false

# Optional rate-limit/ddos knobs (main.ts has secure defaults)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX_REQUESTS=100
STRICT_RATE_LIMIT_WINDOW_MS=60000
STRICT_RATE_LIMIT_MAX_REQUESTS=5
TRUSTED_IPS=
DDOS_LIMIT=
DDOS_BURST=
DDOS_WINDOW_MS=
DDOS_BLACKLIST=
DDOS_WHITELIST=
DDOS_AUTO_BAN_COUNT=
DDOS_AUTO_BAN_TIME=

# Swagger (required by SwaggerService)
SWAGGER_SERVER_LOCAL=http://localhost:4000
SWAGGER_SERVER_PRODUCTION=http://localhost:4000
SWAGGER_USER=docs
SWAGGER_PASSWORD=change-me-swagger-password

# AWS S3 (required for direct lesson video uploads)
AWS_S3_REGION=eu-north-1
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_BUCKET_LIBRARY=

# LMS primary bucket (same as `services/lms` — used by gateway S3Service for LMS GET presign + stable `/api/v1/media/lms/...` streaming)
AWS_S3_REGION_LMS=
AWS_S3_ACCESS_KEY_ID_LMS=
AWS_S3_SECRET_ACCESS_KEY_LMS=
AWS_S3_BUCKET_LMS=

# AWS S3 for instructor CV uploads (required for instructor onboarding)
# Same *_APP vars are used for admin profile avatars (PATCH /api/v1/admin/settings/account); upload runs in the gateway so large files are not sent over NATS.
AWS_S3_REGION_APP=
AWS_S3_ACCESS_KEY_ID_APP=
AWS_S3_SECRET_ACCESS_KEY_APP=
AWS_S3_BUCKET_APP=
AWS_S3_KEY_PREFIX_INSTRUCTOR_CV_APP=instructor-cvs

# AWS S3 for community uploads (articles, posts, comments)
# Region must match the bucket's region or uploads fail with SignatureDoesNotMatch.
AWS_S3_REGION_APP_COMM=
AWS_S3_ACCESS_KEY_ID_APP_COMM=
AWS_S3_SECRET_ACCESS_KEY_APP_COMM=
AWS_S3_BUCKET_APP_COMM=
# Optional: S3-compatible endpoint (MinIO, etc.) — enables path-style URLs
# AWS_S3_ENDPOINT_APP_COMM=

TRUST_PROXY=true