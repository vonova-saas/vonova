# Server Configuration
NODE_ENV=development

# Database Configuration
MONGO_URI_LOCAL_ADMIN=mongodb://127.0.0.1:27017/vonova_admin

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# NATS Configuration
# Local dev (admin runs on host): nats://localhost:4222
# Docker Compose (admin container): nats://nats:4222 (hostname = NATS service name on that network)
NATS_URL=nats://nats:4222

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# API Gateway Configuration (optional)
API_GATEWAY_URL=http://localhost:4000

