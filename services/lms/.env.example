# ==========================
# LMS Service .env.example
# ==========================

# Runtime
NODE_ENV=development

# NATS (internal)
NATS_URL=nats://localhost:4222
NATS_USER=vonova_nats_user
NATS_PASSWORD=change-me-nats-password

# MongoDB
MONGO_URI_LOCAL_LMS=mongodb://127.0.0.1:27017/lms
MONGO_DB_NAME_LMS=lms

# LMS-AI Mongo (optional). If unset, first non-empty feature URI below is used, else same as MONGO_URI_LOCAL_LMS / REMOTE.
MONGO_URI_LMS_AI=

# Optional per-feature AI DB URIs (if separated)
MONGO_URI_ROADMAP_AI_LMS_AI=
MONGO_URI_PDF_SUMMARY_AI_LMS_AI=
MONGO_URI_PDF_SUMMARY_AI_AUDIO_LMS_AI=
MONGO_URI_ASSISTANT_LMS_AI=
MONGO_URI_PROBLEM_SOLVER_LMS_AI=
MONGO_URI_VIDEO_GEN_LMS_AI=

# AI service endpoints (internal)
ROADMAP_AI_SERVICE_URL_LMS_AI=http://roadmap-ai.internal:5000
PDF_SUMMARY_AI_SERVICE_URL_LMS_AI=http://pdf-ai.internal:5015
AI_SERVICE_ALLOWED_HOSTS_LMS_AI=roadmap-ai.internal,pdf-ai.internal
PROBLEM_SOLVING_AI_BASE_URL=http://problem-solving-ai.internal:8000
PROBLEM_SOLVING_AI_TIMEOUT_MS=15000

# Email (optional)
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# AWS S3 — main course/library bucket (vonova-lms)
# Use an IAM user with at least s3:PutObject, s3:GetObject, s3:DeleteObject on AWS_S3_BUCKET_LMS.
# LMS prefers these keys over *_LMS_AI so thumbnail/course deletes are not denied.
AWS_S3_REGION_LMS=eu-north-1
AWS_S3_ACCESS_KEY_ID_LMS=
AWS_S3_SECRET_ACCESS_KEY_LMS=
AWS_S3_BUCKET_LMS=vonova-lms
# Lesson video: browser PUT + <video> GET need S3 CORS on AWS_S3_BUCKET_LMS.
# Edit AllowedOrigins in config/s3-lms-bucket-cors.json (every real app origin), then apply:
#   aws s3api put-bucket-cors --bucket YOUR_BUCKET --cors-configuration file://config/s3-lms-bucket-cors.json
# Presigned GET uses S3ConfigService with requestChecksumCalculation/responseChecksumValidation = WHEN_REQUIRED
# (see lesson/config/s3.config.ts) so URLs avoid x-amz-checksum-mode and Range playback works.
# After CORS or SDK changes: reload the lesson page (or Retry) so streamUrl is regenerated — old URLs stay signed until expiry.
# ORB (Opaque Response Blocking): presigned GET/PUT must see proper CORS + exposed Content-Type; objects should be stored with video/* (see lesson video PUT Content-Type).
AWS_S3_BUCKET_LIBRARY=

# AWS S3 — AI-only bucket (optional; PDF summary etc.)
AWS_ACCESS_KEY_ID_LMS_AI=
AWS_SECRET_ACCESS_KEY_LMS_AI=
AWS_REGION_LMS_AI=eu-north-1
AWS_S3_BUCKET_LMS_AI=vonova-lms-ai-pdf-summary
AWS_S3_PRESIGN_EXPIRES_LMS_AI=180
# Library PDF/slides GET presign TTL (seconds). Used for material view URLs; keep high enough for reading sessions (default 3600). Do not confuse with AWS_S3_PRESIGN_EXPIRES_LMS_AI above (often 180).
AWS_S3_LIBRARY_GET_PRESIGN_EXPIRES=3600


STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

STRIPE_PRO_MONTHLY_PRICE_ID=price_xxxxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxxxx

FRONTEND_URL=https://yourdomain.com