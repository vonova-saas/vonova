VIDEO_GEN_AI_SERVICE_URL=http://127.0.0.1:5000

# DATABASE
MONGO_URI_ROADMAP_AI=mongodb+srv://vonovacompany:SsaTK2cOSSWJi0DQ@auth.6dsl9nu.mongodb.net/ROADMAP_AI

# SECURITY & CORS
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSED_HEADERS=none
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400
CORS_WHITELIST=http://localhost:3000,https://vonova.tech
CORS_BLACKLIST=none
CORS_SECURITY_HEADERS=true

# API DOCUMENTATION
SWAGGER_USER=admin
SWAGGER_PASSWORD=vonova2024

# LOGGING CONFIGURATION
LOG_LEVEL=info
ENABLE_CONSOLE_LOGGING=true
ENABLE_FILE_LOGGING=true
LOG_DIRECTORY=logs
MAX_LOG_FILE_SIZE=5242880
MAX_LOG_FILES=5

# Performance Logging
ENABLE_PERFORMANCE_LOGGING=true
PERFORMANCE_THRESHOLD=1000

# Security Logging
ENABLE_SECURITY_LOGGING=true
LOG_SENSITIVE_DATA=false

# AI Service Logging
ENABLE_AI_SERVICE_LOGGING=true
LOG_AI_REQUESTS=true
LOG_AI_RESPONSES=false

# Database Logging
ENABLE_DATABASE_LOGGING=true
LOG_DATABASE_QUERIES=false
LOG_QUERY_TIME=true

# User Tracking
ENABLE_USER_TRACKING=true
LOG_USER_ACTIONS=true
LOG_USER_PROGRESS=true

# Error Logging
ENABLE_ERROR_LOGGING=true
LOG_ERROR_STACK=true
LOG_ERROR_CONTEXT=true

# RATE LIMITING & SECURITY
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX_REQUESTS=1000
STRICT_RATE_LIMIT_WINDOW_MS=300000
STRICT_RATE_LIMIT_MAX_REQUESTS=50
TRUSTED_IPS=127.0.0.1,::1

# DDoS Protection
DDOS_LIMIT=100
DDOS_BURST=20
DDOS_WINDOW_MS=60000
DDOS_BLACKLIST=none
DDOS_WHITELIST=127.0.0.1,::1
DDOS_AUTO_BAN_COUNT=5
DDOS_AUTO_BAN_TIME=300000

# OPTIONAL SERVICES
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email Configuration (only if email features are used)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_PASSWORD=
EMAIL_USER=
EMAIL_FROM=