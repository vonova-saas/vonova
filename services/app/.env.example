# ==========================
# App Service .env.example
# ==========================

# Runtime
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# NATS (internal)
NATS_URL=nats://localhost:4222
NATS_USER=vonova_nats_user
NATS_PASSWORD=change-me-nats-password

# MongoDB
MONGO_URI_LOCAL_APP=mongodb://localhost:27017/vonova_app
MONGO_DB_NAME_APP=vonova_app

# JWT (required)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FRONTEND_GOOGLE_CALLBACK_URL=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# AWS S3
AWS_S3_REGION_APP=
AWS_S3_ACCESS_KEY_ID_APP=
AWS_S3_SECRET_ACCESS_KEY_APP=
AWS_S3_BUCKET_APP=

# Token blacklist backend (optional; in-memory fallback is automatic)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=auth:blacklist
