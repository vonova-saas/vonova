# ==========================
# App Service .env.example
# ==========================

# Runtime
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Return path-style `/api/v1/media/...` URLs instead of S3 presigned GET (must match LMS + gateway).
STABLE_MEDIA_GET_URLS=true

# When true, predefined admin users are upserted on app startup (see src/common/admin/admin-allowlist.ts).
# For production, prefer `npm run seed:admins` once per deploy and keep this false.
SEED_ADMINS_ON_BOOT=false

# Allowlisted admin emails (required for seeding and ADMIN role). Omit unused slots.
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=
ADMIN_EMAIL_3=
# Initial password for seeded admins (must change on first login). Default in code: Temp@12345 if unset.
SEEDED_ADMIN_TEMP_PASSWORD=

# NATS (internal)
NATS_URL=nats://localhost:4222
NATS_USER=vonova_nats_user
NATS_PASSWORD=change-me-nats-password
# Optional; default vonova-app-queue. All app replicas must use the same queue name.
# NATS_QUEUE=vonova-app-queue

# MongoDB
MONGO_URI_LOCAL_APP=mongodb://127.0.0.1:27017/app
MONGO_DB_NAME_APP=app

# JWT (required)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FRONTEND_GOOGLE_CALLBACK_URL=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
SUPPORT_EMAIL_TO=vonavacompany@gmail.com

# AWS S3
AWS_S3_REGION_APP=
AWS_S3_ACCESS_KEY_ID_APP=
AWS_S3_SECRET_ACCESS_KEY_APP=
AWS_S3_BUCKET_APP=

# AWS S3 for community uploads (articles, posts, comments)
# Region must match the bucket's region (S3 console → bucket → Properties) or PutObject returns SignatureDoesNotMatch.
# Trim keys in .env — trailing spaces or UTF-8 BOM break SigV4.
AWS_S3_REGION_APP_COMM=
AWS_S3_ACCESS_KEY_ID_APP_COMM=
AWS_S3_SECRET_ACCESS_KEY_APP_COMM=
AWS_S3_BUCKET_APP_COMM=
# Optional: MinIO / LocalStack / custom S3-compatible API (forces path-style addressing)
# AWS_S3_ENDPOINT_APP_COMM=http://localhost:9000

# Token blacklist backend (optional; in-memory fallback is automatic)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=auth:blacklist
