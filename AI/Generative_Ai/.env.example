# Cohere API Configuration
CO_API_KEY="your_cohere_api_key_here"
COHERE_API_KEY="your_cohere_api_key_here"

# GEMINI API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"

# SEPER API Configuration
SERPER_API_KEY="your_serper_api_key_here"

# AI Service Configuration
AI_SERVICE_PORT=5010
AI_SERVICE_HOST=0.0.0.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=Agent.log

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://127.0.0.1:3000,http://127.0.0.1:4000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# NLP Configuration
SPACY_MODEL=en_core_web_sm

# Processing Configuration
MAX_CHUNK_SIZE=300
MAX_FILE_SIZE_MB=50

# CrewAI – disable OpenAI dependency
CREWAI_LLM_PROVIDER=cohere
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true
